# Production 必填：Neon PostgreSQL 连接串
# 建议 Production/Preview 使用不同 Neon 数据库或分支。
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Production 必填：V2 正式公开 URL，不要带末尾斜杠
# QStash 会向该域名下的内部事件路由投递消息。
APP_BASE_URL="https://your-v2-app.vercel.app"

# Production 必填：在 Upstash Console 创建 QStash 后复制以下三个值
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
QSTASH_FLOW_CONTROL_KEY="v2-import-worker"
QSTASH_WORKER_PARALLELISM="4"
QSTASH_RETRIES="3"
QSTASH_RETRY_DELAY="1000"

# Production 必填：Vercel Private Blob Store
# BLOB_READ_WRITE_TOKEN 由 Vercel 绑定 Blob Store 后自动注入；不要暴露给浏览器。
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
IMPORT_BLOB_RETENTION_HOURS="24"
IMPORT_MAX_FILE_SIZE_MB="50"

# V2 提供给 V3 的 /api/v1/* 服务间鉴权密钥
V2_API_KEY="replace-with-a-long-random-secret"
# V3 生产域名；本地开发默认 http://localhost:3100
CORS_ALLOWED_ORIGIN="https://your-v3-app.vercel.app"

# 可选：手工执行恢复/Blob 清理控制面的应急密钥；QStash 正式调用使用签名验证
IMPORT_WORKER_TOKEN="replace-with-a-different-long-random-secret"
IMPORT_CLEANUP_TOKEN="replace-with-another-long-random-secret"

# 导入性能参数
IMPORT_BATCH_SIZE="1000"
IMPORT_WORKER_CONCURRENCY="4"
SKU_VALIDATION_TIMEOUT_MS="3000"

# AI 解析规则生成（启用 AI 功能时必填）
DEEPSEEK_API_URL="https://api.example.com/v1/chat/completions"
DEEPSEEK_API_KEY="replace-with-provider-api-key"
DEEPSEEK_MODEL="replace-with-model-name"

# 仅本地/CI 测试使用，不需要配置到 Vercel Production
LOAD_TEST_BASE_URL="http://localhost:3000"
LOAD_TEST_RULE_ID=""
LOAD_TEST_FILE="test-data/10000-orders-fixed.xlsx"
RUN_NEON_INTEGRATION_TEST="false"
