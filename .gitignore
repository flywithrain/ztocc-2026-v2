# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js（包括本地验收使用的 .next-test、.next-final* 等独立构建目录）
/.next*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/scripts/_*.js

# npm pack / 本地依赖调研临时包
/*.tgz

# env files（提交无密钥模板，忽略真实配置）
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Office 临时锁文件
/**/~$*.xlsx

# 压测运行输出与旧版数据默认不提交，仅保留最终修正版 Excel
/test-data/*
!/test-data/10000-orders-fixed.xlsx

# 本地 HTTP/浏览器烟测过程文件；正式证据统一放 docs/exam-delivery/evidence
/*.check.html
/*-check.html
/.*-check.html
/*-check.json
/.*-check.json
/*-snapshot.yaml
/*-before.png
/*-before.yaml
/monitor-page*.png
/task-page*.png
/import-history-trace.yaml
